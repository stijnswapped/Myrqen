node_modules/
.pnpm-store/
.turbo/
.next/
dist/
dist-tsc/
coverage/
.env
.env.local
*.log
.DS_Store

# Local scan state produced by the CLI inside a scanned repository.
.myrqen/local.json
.myrqen/reports/
.myrqen/sessions/
.myrqen/current-session

# Local development data and generated release material.
.data/
release/
*.private.pem
*.public.pem
benchmark/last-run.json

# Generated at build time from packages/skill/myrqen.
apps/cli/skill/

# Audit scratch
.audit/object-store/
/tmp-audit/

# Workflow worktrees are separate checkouts, not part of this tree.
.claude/worktrees/

# Incremental TypeScript build state; regenerated by every build.
*.tsbuildinfo

# The fixture env files are committed deliberately. They contain only fake values,
# and the redaction tests read real env files rather than examples, so a clean clone
# cannot run the suite without them.
!fixtures/*/.env
