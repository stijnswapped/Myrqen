node_modules/
.pnpm-store/
.turbo/
.next/
dist/
dist-tsc/
coverage/
.env
.env.local
*.log
.DS_Store

# Local scan state produced by the CLI inside a scanned repository. The patterns
# are depth-prefixed because a pattern containing a slash is anchored to this
# file's own directory: `.myrqen/reports/` never matched
# `fixtures/vuln-shop/.myrqen/reports/`, so every run of the acceptance suite or
# the benchmark left a full report of a deliberately vulnerable fixture sitting
# untracked in the tree, one `git add -A` away from being published.
**/.myrqen/local.json
**/.myrqen/reports/
**/.myrqen/sessions/
**/.myrqen/current-session

# Local development data and generated release material.
.data/
release/
*.private.pem
*.public.pem
benchmark/last-run.json

# Generated at build time from packages/skill/myrqen.
apps/cli/skill/
# Copied from the repository root at build time so the tarball carries it.
apps/cli/LICENSE

# Audit scratch
.audit/object-store/
/tmp-audit/

# Workflow worktrees are separate checkouts, not part of this tree.
.claude/worktrees/

# Incremental TypeScript build state; regenerated by every build.
*.tsbuildinfo

# Python bytecode from tools/, regenerated on every run.
__pycache__/
*.pyc

# The fixture env files are committed deliberately. They contain only fake values,
# and the redaction tests read real env files rather than examples, so a clean clone
# cannot run the suite without them.
!fixtures/*/.env

# Scratch files agents leave behind while investigating.
.tmp-*

# Local tooling config and caches from editor/agent skills.
.impeccable/
.github/hooks/

# Working notes between sessions. Not project documentation, not a commitment to
# anyone outside the project, and deliberately never pushed.
TODOLATER.md

# Agent-run cache: keyed by case, run index and prompt hash. Reproducible, and large.
benchmark/.agent-cache/
