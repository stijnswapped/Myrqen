{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Myrqen project binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "workspaceId",
    "projectId"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "team"
      ]
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
