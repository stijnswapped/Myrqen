{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.myrqen.invalid/finding.schema.json",
  "title": "Myrqen Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","title","category","severity","verification","summary","impact","affected","evidence","remediation","verificationPlan"],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","description"],
      "properties": {
        "kind": { "enum": ["source","runtime","identity_differential","configuration","dependency","other"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "snippet": { "type": "string", "maxLength": 24000 },
        "location": { "type": "string", "maxLength": 1000 },
        "redacted": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "category": { "type": "string", "minLength": 1, "maxLength": 120 },
    "taxonomy": { "type": "array", "items": { "type": "string", "maxLength": 64 }, "maxItems": 16 },
    "severity": { "enum": ["critical","high","medium","low","info"] },
    "verification": { "enum": ["verified","strong_evidence","needs_review"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "impact": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "affected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component"],
      "properties": {
        "component": { "type": "string", "minLength": 1, "maxLength": 500 },
        "file": { "type": "string", "maxLength": 1000 },
        "lineStart": { "type": "integer", "minimum": 1 },
        "lineEnd": { "type": "integer", "minimum": 1 },
        "route": { "type": "string", "maxLength": 1000 },
        "origin": { "type": "string", "maxLength": 1000 }
      }
    },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/evidence" } },
    "corroboration": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/evidence" } },
    "remediation": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "verificationPlan": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "reproduction": { "type": "string", "maxLength": 12000 },
    "references": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 32 },
    "fingerprint": { "type": "string", "maxLength": 128 },
    "secretReferences": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label","kind","fingerprint"],
        "properties": {
          "label": { "type": "string", "maxLength": 200 },
          "kind": { "type": "string", "maxLength": 80 },
          "fingerprint": { "type": "string", "maxLength": 128 },
          "location": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "status": { "enum": ["open","fix_suggested","fix_applied","fixed_verified","accepted_risk","false_positive"] },
    "fixedAt": { "type": "string", "format": "date-time" },
    "fixHistory": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at","action","verified"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "action": { "enum": ["suggested","applied","verified","verification_failed","reverted"] },
          "verified": { "type": "boolean" },
          "changedFiles": { "type": "array", "items": { "type": "string", "maxLength": 1000 }, "maxItems": 200 },
          "note": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "firstSeenAt": { "type": "string", "format": "date-time" },
    "tags": { "type": "array", "items": { "type": "string", "maxLength": 80 }, "maxItems": 32 }
  }
}
