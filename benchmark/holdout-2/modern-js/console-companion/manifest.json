{
  "manifest_version": 3,
  "name": "Console Companion",
  "version": "1.4.2",
  "description": "Pin a project's build status to the toolbar and open logs in one click.",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": { "default_popup": "popup/index.html" },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://api.console.example.com/*"],
  "externally_connectable": {
    "matches": ["*://*/*"]
  }
}
